# =====================================================================
# Campaign C (3D) -- test cell: lasy-fork exporter via file injection
# (epoch3d spatiotemporal path).
# ---------------------------------------------------------------------
# Same beam and grid as ../native/. Binary pair from the lasy fork's
# Laser.write_to_file(file_format="epoch") -- generate first (the ~91 MB
# .dat files are deliberately NOT in git):
#   python ../generate_lasy_exporter.py
# On Viking, run the generator via sbatch (numpy FFTs on a ~180 MB
# envelope; do not run it on the login node), after pip-installing the
# lasy fork -- or rsync the locally generated files instead.
# Carrier pin: carrier_phase_ref = psi_bnd_3d baked into the phase file,
# matching ../native/'s phase_const = pi/2 + psi_bnd_3d.
# NOTE (epoch3d spatiotemporal + MPI): this path previously aborted under
# multi-rank domain decomposition (pre-slab-loading builds); smoke-test a
# small run at the production rank count before the full job -- see
# ../../VIKING_PROMPT_campaign_C.md.
# =====================================================================

begin:control
  nx = 434
  ny = 451
  nz = 451

  x_min = 0
  x_max = 1.809557368467721e-5
  y_min = -9.391485505499118e-6
  y_max =  9.391485505499118e-6
  z_min = -9.391485505499118e-6
  z_max =  9.391485505499118e-6

  t_end = 350 * femto
  stdout_frequency = 50
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries

begin:laser
  boundary = x_min
  lambda = 1.0 * micron
  amp = 3.2e12

  use_custom_profile = T
  use_spatiotemporal_profile = T
  profile_data_file = laser_amplitude.dat

  use_phase_from_file = T
  phase_data_file = laser_phase.dat

  n_tr1 = 151
  n_tr2 = 151
  n_t = 501
  tr1_min = -9.391485505499118e-6
  tr1_max =  9.391485505499118e-6
  tr2_min = -9.391485505499118e-6
  tr2_max =  9.391485505499118e-6
  t_start = 0
  t_end = 3.5e-13

  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 25 * femto
  grid = always
  ex = always
  ey = always
  ez = always
end:output
