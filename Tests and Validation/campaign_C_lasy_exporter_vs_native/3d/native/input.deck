# =====================================================================
# Campaign C (3D) -- reference cell: EPOCH's NATIVE laser injector.
# ---------------------------------------------------------------------
# Identical to campaign A's 3D amp_deck_phase_deck baseline (same beam,
# same grid, FULL Gouy phase_const for the circularly-symmetric r_yz
# beam). Partner cell: ../lasy_file/ (same beam via the lasy fork's new
# write_to_file exporter, epoch3d spatiotemporal path).
# =====================================================================

begin:control
  nx = 434
  ny = 451
  nz = 451

  x_min = 0
  x_max = 1.809557368467721e-5
  y_min = -9.391485505499118e-6
  y_max =  9.391485505499118e-6
  z_min = -9.391485505499118e-6
  z_max =  9.391485505499118e-6

  t_end = 350 * femto
  stdout_frequency = 50
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries

begin:constant
  w_bnd        = 2.6832815729997478e-6
  phase_const  = 0.46364760900080615
  phase_quad   = 277777777777.77783
end:constant

begin:laser
  boundary = x_min
  lambda = 1.0 * micron
  amp = 3.2e12

  profile = gauss(r_yz, 0, w_bnd)
  phase = phase_const + phase_quad*(r_yz*r_yz)

  t_profile = gauss(time, 200 * femto, 80 * femto)
  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 25 * femto
  grid = always
  ex = always
  ey = always
  ez = always
end:output
