# =====================================================================
# Test B (3D) -- f/1 tight-focusing demo: PARAXIAL, SMOKE TEST (coarse)
# ---------------------------------------------------------------------
# Coarse-resolution sanity check before committing the full allocation
# (see VIKING_PROMPT_urgent_2x2_and_f1_demo.md: the 3D paraxial generator
# has the corrected sign convention but was not smoke-tested end-to-end
# in EPOCH). Same box extents as ../input.deck, but nx/ny/nz reduced
# ~4x per axis (147.2M -> ~2M cells) so this runs fast. Reuses the
# already-generated ../spatial_profile.dat and ../phase_profile.dat via
# a relative path -- do NOT regenerate/duplicate those large files here.
# =====================================================================

begin:control
  nx = 80
  ny = 160
  nz = 160

  x_min = 0
  x_max = 1.01859163578813e-5
  y_min = -1.0499402259312835e-5
  y_max =  1.0499402259312835e-5
  z_min = -1.0499402259312835e-5
  z_max =  1.0499402259312835e-5

  t_end = 150 * femto
  stdout_frequency = 100
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries

begin:laser
  boundary = x_min
  lambda = 1.0 * micron
  amp = 3.2e12

  use_custom_profile = T
  use_spatiotemporal_profile = T
  profile_data_file = ../spatial_profile.dat

  use_phase_from_file = T
  phase_data_file = ../phase_profile.dat

  n_y_points = 400
  n_z_points = 400
  n_t_points = 500
  y_min = -1.0499402259312835e-5
  y_max =  1.0499402259312835e-5
  z_min = -1.0499402259312835e-5
  z_max =  1.0499402259312835e-5
  t_start = 0
  t_end = 9e-14

  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 10 * femto
  grid = always
  ex = always
  ey = always
  ez = always
  by = always
  bz = always
end:output
