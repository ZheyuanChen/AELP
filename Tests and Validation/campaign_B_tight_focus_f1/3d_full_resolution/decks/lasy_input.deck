# =====================================================================
# Test B (3D) -- f/1 tight-focusing demo: LASY (non-paraxial) via injector
# ---------------------------------------------------------------------
# Injector-only, spatiotemporal path. Generate the files first:
#   python ../generate_lasy.py
#
# NOTE: see ../paraxial/input.deck's header -- the spatiotemporal path's
# MPI abort under multi-rank decompositions was root-caused and fixed in
# commit aa605cca. Confirm the Viking-side epoch_dev checkout is current.
# =====================================================================

begin:control
  nx = 326
  ny = 672
  nz = 672

  x_min = 0
  x_max = 1.01859163578813e-5
  y_min = -1.0499402259312835e-5
  y_max =  1.0499402259312835e-5
  z_min = -1.0499402259312835e-5
  z_max =  1.0499402259312835e-5

  t_end = 150 * femto
  stdout_frequency = 100

  # See ../paraxial/input.deck's use_pre_balance comment -- same fix,
  # same reasoning (vacuum deck, nothing for pre-balance to do, and the
  # full-plane-per-rank fallback it triggers OOM'd at N_TR=1200).
  use_pre_balance = F
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries

begin:laser
  boundary = x_min
  lambda = 1.0 * micron
  amp = 3.2e12

  use_custom_profile = T
  use_spatiotemporal_profile = T
  profile_data_file = spatial_profile.dat

  use_phase_from_file = T
  phase_data_file = phase_profile.dat

  n_y_points = 1200
  n_z_points = 1200
  n_t_points = 500
  y_min = -1.0499402259312835e-5
  y_max =  1.0499402259312835e-5
  z_min = -1.0499402259312835e-5
  z_max =  1.0499402259312835e-5
  t_start = 0
  t_end = 9e-14

  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 10 * femto
  grid = always
  ex = always
  ey = always
  ez = always
  by = always
  bz = always
end:output
