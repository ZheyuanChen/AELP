# =====================================================================
# Test A (3D) -- injector isolation, cell 2/3: AMPLITUDE from file,
# phase native. Isolates the amplitude injector's own error (interpolation
# + binary I/O) against the amp_deck_phase_deck baseline, with phase held
# on the identical native expression in both. Generate the file first:
#   python ../generate_profile.py
# =====================================================================

begin:control
  nx = 434
  ny = 451
  nz = 451

  x_min = 0
  x_max = 1.809557368467721e-5
  y_min = -9.391485505499118e-6
  y_max =  9.391485505499118e-6
  z_min = -9.391485505499118e-6
  z_max =  9.391485505499118e-6

  t_end = 350 * femto
  stdout_frequency = 50
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries

begin:constant
  phase_const  = 0.46364760900080615
  phase_quad   = 277777777777.77783
end:constant

begin:laser
  boundary = x_min
  lambda = 1.0 * micron
  amp = 3.2e12

  use_custom_profile = T
  use_spatiotemporal_profile = F
  profile_data_file = spatial_profile.dat
  n_y_points = 1200
  n_z_points = 1200
  y_min = -9.391485505499118e-6
  y_max =  9.391485505499118e-6
  z_min = -9.391485505499118e-6
  z_max =  9.391485505499118e-6

  # phase stays on the native expression (use_phase_from_file left F)
  phase = phase_const + phase_quad*(r_yz*r_yz)

  t_profile = gauss(time, 200 * femto, 80 * femto)
  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 25 * femto
  grid = always
  ex = always
  ey = always
  ez = always
  by = always
  bz = always
end:output