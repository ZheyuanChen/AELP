# =====================================================================
# Test A (3D) -- injector isolation, cell 3/3: BOTH amplitude and phase
# from file (static spatial path, use_phase_from_file=T -- the "new,
# never existed in the text era" path). Compare against amp_file_phase_deck
# to isolate the PHASE injector's additional contribution on top of the
# already-measured amplitude injector error; compare against
# amp_deck_phase_deck for the total combined effect. Generate the files
# first: python ../generate_profile.py
# =====================================================================

begin:control
  nx = 434
  ny = 451
  nz = 451

  x_min = 0
  x_max = 1.809557368467721e-5
  y_min = -9.391485505499118e-6
  y_max =  9.391485505499118e-6
  z_min = -9.391485505499118e-6
  z_max =  9.391485505499118e-6

  t_end = 350 * femto
  stdout_frequency = 50
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries

begin:laser
  boundary = x_min
  lambda = 1.0 * micron
  amp = 3.2e12

  use_custom_profile = T
  use_spatiotemporal_profile = F
  profile_data_file = spatial_profile.dat

  use_phase_from_file = T
  phase_data_file = phase_profile.dat

  n_y_points = 1200
  n_z_points = 1200
  y_min = -9.391485505499118e-6
  y_max =  9.391485505499118e-6
  z_min = -9.391485505499118e-6
  z_max =  9.391485505499118e-6

  t_profile = gauss(time, 200 * femto, 80 * femto)
  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 25 * femto
  grid = always
  ex = always
  ey = always
  ez = always
  by = always
  bz = always
end:output