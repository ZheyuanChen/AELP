# =====================================================================
# Test 1 (3D) -- converging Gaussian beam: NUMERICAL (file-injected) run
# ---------------------------------------------------------------------
# Same beam as analytical/input.deck, but amplitude AND phase come from
# binary files (spatial_profile.dat, phase_profile.dat -- static spatial
# path, use_spatiotemporal_profile = F, use_phase_from_file = T) rather
# than native deck expressions. Generate the files first:
#   python generate_profile.py
#
# This is the "static phase-from-file" path that was new in the v2.1.0
# epoch3d port and previously only exercised with a trivial all-zero
# phase file -- this is its first exercise with real, non-trivial
# curvature+Gouy physics.
#
# All physics/geometry constants below MUST match physics_params.py and
# analytical/input.deck exactly -- see physics_params.py.
# =====================================================================

begin:control
  nx = 434
  ny = 451
  nz = 451

  x_min = 0
  x_max = 18.095574e-6
  y_min = -9.391485e-6
  y_max =  9.391485e-6
  z_min = -9.391485e-6
  z_max =  9.391485e-6

  t_end = 350 * femto
  stdout_frequency = 50
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries

begin:constant
  lambda0 = 1.0 * micron
  w0      = 1.2 * micron
  x_R     = pi * w0 * w0 / lambda0
  x_spot  = 2.0 * x_R
  xi_bnd  = -x_spot
  w_bnd   = w0 * sqrt(1.0 + (xi_bnd/x_R)*(xi_bnd/x_R))
end:constant

begin:laser
  boundary = x_min
  lambda = lambda0
  amp = 3.2e12

  use_custom_profile = T
  use_spatiotemporal_profile = F           # static (y,z) plane, not (y,z,t)
  profile_data_file = spatial_profile.dat

  use_phase_from_file = T
  phase_data_file = phase_profile.dat

  # File grid: MUST equal generate_profile.py's FILE_TR_MIN/MAX (which is
  # exactly +/- 3.5*w_bnd, i.e. the FULL simulation transverse extent --
  # no clamp/zero-pad edge case, see the logged out-of-file-grid issue).
  n_y_points = 1200
  n_z_points = 1200
  y_min = -3.5 * w_bnd
  y_max =  3.5 * w_bnd
  z_min = -3.5 * w_bnd
  z_max =  3.5 * w_bnd

  # Temporal envelope: identical to analytical/input.deck. Note this is
  # independent of use_custom_profile/use_spatiotemporal (laser_time_profile
  # uses t_profile whenever use_time_function=T, regardless of the spatial
  # injection path -- see laser.f90:laser_time_profile).
  t_profile = gauss(time, 200 * femto, 80 * femto)

  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 25 * femto
  grid = always
  ex = always
  ey = always
  ez = always
  by = always
  bz = always
end:output
