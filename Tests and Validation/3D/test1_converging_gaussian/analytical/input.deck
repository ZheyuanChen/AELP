# =====================================================================
# Test 1 (3D) -- converging Gaussian beam: ANALYTICAL reference run
# ---------------------------------------------------------------------
# EPOCH's native deck-expression profile/phase (gauss(r_yz,...) + the
# closed-form paraxial curvature/Gouy phase), NOT the file injector.
# Compared against numerical/ (same beam, injected via the binary
# profile/phase files) to isolate injector-pipeline error from paraxial-
# approximation error, and against theory (see physics_params.py and
# analyse.py) to validate both against the closed-form Gaussian beam
# formula for w(x), x_focus, w0, and transverse power conservation.
#
# All physics/geometry constants below MUST match physics_params.py and
# numerical/input.deck exactly -- see physics_params.py for the derivation
# and the printed summary (`python physics_params.py`).
#
# Beam: lambda0=1 um, w0=1.2 um -> NA~0.265 (moderate; well within
# paraxial validity -- this test validates the *pipeline*, not the f/1
# NA=0.5 physics). Focus at box centre (x=x_spot), injection at x_min=0.
# =====================================================================

begin:control
  nx = 434
  ny = 451
  nz = 451

  x_min = 0
  x_max = 18.095574e-6
  y_min = -9.391485e-6
  y_max =  9.391485e-6
  z_min = -9.391485e-6
  z_max =  9.391485e-6

  t_end = 350 * femto
  stdout_frequency = 50
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
  bc_z_min = open
  bc_z_max = open
end:boundaries

begin:constant
  lambda0 = 1.0 * micron
  w0      = 1.2 * micron
  k0      = 2.0 * pi / lambda0
  x_R     = pi * w0 * w0 / lambda0
  x_spot  = 2.0 * x_R                        # boundary-to-focus distance
  xi_bnd  = -x_spot                          # boundary position rel. focus
  w_bnd   = w0 * sqrt(1.0 + (xi_bnd/x_R)*(xi_bnd/x_R))
  R_bnd   = xi_bnd * (1.0 + (x_R/xi_bnd)*(x_R/xi_bnd))
  psi_bnd = atan(xi_bnd / x_R)
end:constant

begin:laser
  boundary = x_min
  lambda = lambda0
  amp = 3.2e12

  # Spatial envelope + curvature/Gouy phase (paraxial Gaussian beam,
  # see physics_params.py). r_yz = sqrt(y^2+z^2) is an EPOCH built-in.
  profile = gauss(r_yz, 0, w_bnd)
  phase = pi/2.0 + psi_bnd - k0*(r_yz*r_yz)/(2.0*R_bnd)

  # Temporal envelope: peak chosen so it reaches the focus (x=x_spot)
  # near the middle of the run -- best SNR exactly where w(x) is
  # smallest and hardest to resolve. See physics_params.py.
  t_profile = gauss(time, 200 * femto, 80 * femto)

  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 25 * femto
  grid = always
  ex = always
  ey = always
  ez = always
  by = always
  bz = always
end:output