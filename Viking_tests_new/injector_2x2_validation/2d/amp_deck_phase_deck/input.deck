# =====================================================================
# Test A (2D) -- injector isolation, cell 1/3: BASELINE (fully native)
# ---------------------------------------------------------------------
# 2D-slab analogue of ../../3d/amp_deck_phase_deck -- same beam
# (lambda0, w0, x_spot) but HALF Gouy phase (1D-transverse slab, see
# physics_params.py docstring). "Cast together" with the 3D campaign for
# direct comparison in the progress report.
# =====================================================================

begin:control
  nx = 434
  ny = 451

  x_min = 0
  x_max = 1.809557368467721e-5
  y_min = -9.391485505499118e-6
  y_max =  9.391485505499118e-6

  t_end = 350 * femto
  stdout_frequency = 50
end:control

begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = open
  bc_y_max = open
end:boundaries

begin:constant
  w_bnd        = 2.6832815729997478e-6
  phase_const  = 1.0172219678978514
  phase_quad   = 277777777777.77783
end:constant

begin:laser
  boundary = x_min
  lambda = 1.0 * micron
  amp = 3.2e12

  profile = gauss(y, 0, w_bnd)
  phase = phase_const + phase_quad*(y*y)

  t_profile = gauss(time, 200 * femto, 80 * femto)
  polarisation_angle = 0.0
end:laser

begin:output
  dt_snapshot = 25 * femto
  grid = always
  ex = always
  ey = always
  ez = always
  by = always
  bz = always
end:output
